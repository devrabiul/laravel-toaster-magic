{
    "name": "devrabiul/laravel-toaster-magic",
    "type": "library",
    "description": "Laravel Toaster Magic is a lightweight, flexible toast library for Laravel projects, with no jQuery, Bootstrap, or Tailwind dependency.",
    "keywords": [
        "laravel",
        "toaster",
        "magic",
        "notifications",
        "toastr",
        "flash-notifications",
        "dynamic-notifications",
        "laravel-toastr",
        "php",
        "livewire",
        "livewire-toaster"
    ],
    "homepage": "https://github.com/devrabiul/laravel-toaster-magic",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Rabiul",
            "email": "devrabiul@gmail.com",
            "homepage": "https://rixetbd.com",
            "role": "Software Engineer"
        }
    ],
    "support": {
        "issues": "https://github.com/devrabiul/laravel-toaster-magic/issues",
        "source": "https://github.com/devrabiul/laravel-toaster-magic",
        "docs": "https://github.com/devrabiul/laravel-toaster-magic#readme"
    },
    "autoload": {
        "psr-4": {
            "Devrabiul\\ToastMagic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devrabiul\\ToastMagic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devrabiul\\ToastMagic\\ToastMagicServiceProvider"
            ],
            "aliases": {
                "ToastMagic": "Devrabiul\\ToastMagic\\Facades\\ToastMagic"
            }
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/config": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0 || ^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
